{
  "name": "@wortomat/backend",
  "version": "2.0.0",
  "private": true,
  "description": "Lokales REST-Backend (NestJS). Läuft im Electron-Hauptprozess oder eigenständig für die Entwicklung.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -r \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir dist-test && node --test --enable-source-maps \"dist-test/**/*.spec.js\""
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "docx": "^9.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.9.0",
    "@wortomat/shared": "*"
  }
}
